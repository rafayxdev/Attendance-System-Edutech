# Database
DATABASE_URL=postgresql://user:password@host:5432/db

# Auth
JWT_SECRET=your-long-random-secret-here

# Access Control
ACCESS_PROFILE=home
ACCESS_GATE_ENFORCED=false
ALLOWED_IP_PREFIXES=137.59.221.136,137.59.223.136

# Campus Location (for university profile)
CAMPUS_LAT=25.3833456
CAMPUS_LNG=68.3844759
CAMPUS_RADIUS_METERS=250

# Email (optional)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM=EduTech Interns <edutechinterns@gmail.com>

# App URLs (for production)
APP_PUBLIC_URL=https://your-web-domain.vercel.app
API_PUBLIC_URL=https://your-web-domain.vercel.app

# Timezone
APP_TIMEZONE=Asia/Karachi

# Web (for Vite)
VITE_API_URL=https://your-web-domain.vercel.app

# Node
NODE_ENV=production
PORT=4000
