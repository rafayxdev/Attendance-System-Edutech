{
  "buildCommand": "cd apps/api && npx prisma generate && cd ../.. && npm run build -w @edutech/web",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
